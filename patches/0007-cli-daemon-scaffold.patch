@@ -226,6 +227,10 @@ static CLI::GERBER_INFO_COMMAND        gerberInfoCmd{};
 static CLI::GERBER_DIFF_COMMAND        gerberDiffCmd{};
 static CLI::VERSION_COMMAND            versionCmd{};
 static CLI::API_SERVER_COMMAND         apiServerCmd{};
+static CLI::DAEMON_COMMAND             daemonCmd{};
+static CLI::DAEMON_START_COMMAND       daemonStartCmd{};
+static CLI::DAEMON_STOP_COMMAND        daemonStopCmd{};
+static CLI::DAEMON_STATUS_COMMAND      daemonStatusCmd{};
 
 // clang-format off
 static std::vector<COMMAND_ENTRY> commandStack = {
@@ -388,6 +393,14 @@ static std::vector<COMMAND_ENTRY> commandStack = {
     },
     {
         &apiServerCmd,
