+#ifndef COMMAND_DAEMON_H
+#define COMMAND_DAEMON_H
+
+#include "command.h"
+
+namespace CLI
+{
+/**
+ * `kicad-cli daemon` — parent noun for the long-lived kicad-cli server.
+ *
+ * The daemon collapses the ~700-900 ms fixed startup cost of every
+ * `kicad-cli` invocation to a one-time cost, and reuses a per-path
+ * BOARD cache across requests. Designed for CI-shaped workflows that
+ * call kicad-cli many times against the same board.
+ *
+ * See analysis/02-daemon-mode-design.md in the kicad-perf repo.
+ */
+class DAEMON_COMMAND : public COMMAND
+{
+public:
+    DAEMON_COMMAND();
+
+protected:
+    int doPerform( KIWAY& aKiway ) override;
+};
+
+
+class DAEMON_START_COMMAND : public COMMAND
+{
+public:
+    DAEMON_START_COMMAND();
+
+protected:
+    int doPerform( KIWAY& aKiway ) override;
+};
+
+
+class DAEMON_STOP_COMMAND : public COMMAND
+{
+public:
+    DAEMON_STOP_COMMAND();
+
+protected:
+    int doPerform( KIWAY& aKiway ) override;
+};
+
+
+class DAEMON_STATUS_COMMAND : public COMMAND
+{
+public:
+    DAEMON_STATUS_COMMAND();
+
+protected:
+    int doPerform( KIWAY& aKiway ) override;
+};
+
+} // namespace CLI
+
+#endif // COMMAND_DAEMON_H
