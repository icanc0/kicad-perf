+#include "command_daemon.h"
+#include <cli/exit_codes.h>
+#include <wx/crt.h>
+
+// This file is the scaffolding for `kicad-cli daemon {start,stop,status}`.
+// See analysis/02-daemon-mode-design.md for the plan. Subsequent patches
+// wire in the actual Unix-socket server, client stub, dispatcher, and
+// per-path BOARD cache.
+
+
+#define ARG_SOCKET "--socket"
+
+
+CLI::DAEMON_COMMAND::DAEMON_COMMAND() : COMMAND( "daemon" )
+{
+    m_argParser.add_description(
+            UTF8STDSTR( _( "Manage a long-lived kicad-cli server (start / stop / status)" ) ) );
+}
+
+
+int CLI::DAEMON_COMMAND::doPerform( KIWAY& )
+{
+    // Parent verb: print usage rather than error, matches other top-level
+    // command groups like `pcb` and `sch`.
+    PrintHelp();
+    return EXIT_CODES::OK;
+}
+
+
+CLI::DAEMON_START_COMMAND::DAEMON_START_COMMAND() : COMMAND( "start" )
+{
+    m_argParser.add_description( UTF8STDSTR( _( "Start the kicad-cli daemon in the foreground" ) ) );
+
+    m_argParser.add_argument( ARG_SOCKET )
+            .default_value( std::string() )
+            .help( UTF8STDSTR(
+                    _( "Unix socket path (default: $XDG_RUNTIME_DIR/kicad-cli.sock)" ) ) )
+            .metavar( "PATH" );
+}
+
+
+int CLI::DAEMON_START_COMMAND::doPerform( KIWAY& )
+{
+    wxFprintf( stderr,
+               _( "daemon start: not yet implemented (scaffold only).\n"
+                  "See analysis/02-daemon-mode-design.md for the plan.\n" ) );
+    return EXIT_CODES::ERR_UNKNOWN;
+}
+
+
+CLI::DAEMON_STOP_COMMAND::DAEMON_STOP_COMMAND() : COMMAND( "stop" )
+{
+    m_argParser.add_description(
+            UTF8STDSTR( _( "Signal a running kicad-cli daemon to exit cleanly" ) ) );
+
+    m_argParser.add_argument( ARG_SOCKET )
+            .default_value( std::string() )
+            .help( UTF8STDSTR( _( "Unix socket path" ) ) )
+            .metavar( "PATH" );
+}
+
+
+int CLI::DAEMON_STOP_COMMAND::doPerform( KIWAY& )
+{
+    wxFprintf( stderr, _( "daemon stop: not yet implemented (scaffold only).\n" ) );
+    return EXIT_CODES::ERR_UNKNOWN;
+}
+
+
+CLI::DAEMON_STATUS_COMMAND::DAEMON_STATUS_COMMAND() : COMMAND( "status" )
+{
+    m_argParser.add_description(
+            UTF8STDSTR( _( "Print daemon liveness and cache statistics" ) ) );
+
+    m_argParser.add_argument( ARG_SOCKET )
+            .default_value( std::string() )
+            .help( UTF8STDSTR( _( "Unix socket path" ) ) )
+            .metavar( "PATH" );
+}
+
+
+int CLI::DAEMON_STATUS_COMMAND::doPerform( KIWAY& )
+{
+    wxFprintf( stderr, _( "daemon status: not yet implemented (scaffold only).\n" ) );
+    return EXIT_CODES::ERR_UNKNOWN;
+}
