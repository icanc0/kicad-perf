From fe0a60451a531146e855d75f0e9d7b0986b8d7a3 Mon Sep 17 00:00:00 2001
From: icanc0 <ai7@vincentxie.net>
Date: Sat, 22 Aug 2026 01:37:09 +0000
Subject: [PATCH] P31: extend 64 KB stdio buffer to gencad + IPC-D-356
 exporters
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Same pattern as 0022 and 0024 — GenCAD and IPC-D-356 exporters open
their output via wxFopen and never setvbuf, so they run on stdio's
default ~4-8 KB buffer. Both formats emit many short lines. Bump to
64 KB.
---
 pcbnew/exporters/export_d356.cpp          | 5 +++++
 pcbnew/exporters/export_gencad_writer.cpp | 6 ++++++
 2 files changed, 11 insertions(+)

diff --git a/pcbnew/exporters/export_d356.cpp b/pcbnew/exporters/export_d356.cpp
index fce87fcf..3ab2456e 100644
--- a/pcbnew/exporters/export_d356.cpp
+++ b/pcbnew/exporters/export_d356.cpp
@@ -24,6 +24,7 @@
  */
 #include "export_d356.h"
 
+#include <cstdio>
 #include <vector>
 #include <cctype>
 
@@ -373,6 +374,10 @@ bool IPC356D_WRITER::Write( const wxString& aFilename )
         return false;
     }
 
+    // Perf (kicad-perf 0022 companion): bigger stdio buffer for the same
+    // reason the plot files got one.
+    (void) std::setvbuf( file, nullptr, _IOFBF, 64 * 1024 );
+
     // This will contain everything needed for the 356 file
     std::vector<D356_RECORD> d356_records;
 
diff --git a/pcbnew/exporters/export_gencad_writer.cpp b/pcbnew/exporters/export_gencad_writer.cpp
index d872ada7..084970fe 100644
--- a/pcbnew/exporters/export_gencad_writer.cpp
+++ b/pcbnew/exporters/export_gencad_writer.cpp
@@ -18,6 +18,7 @@
  */
 #include "export_gencad_writer.h"
 
+#include <cstdio>
 #include <build_version.h>
 #include <common.h>
 #include <board.h>
@@ -163,6 +164,11 @@ bool GENCAD_EXPORTER::WriteFile( const wxString& aFullFileName )
     if( !m_file )
         return false;
 
+    // Perf (kicad-perf 0022 companion): bigger stdio buffer for the same
+    // reason the plot files got one — GenCAD exports thousands of short
+    // lines through fprintf; default BUFSIZ triggers many write() syscalls.
+    (void) std::setvbuf( m_file, nullptr, _IOFBF, 64 * 1024 );
+
     BOARD*  pcb = m_board;
 
     // Update some board data, to ensure a reliable GenCAD export.
-- 
2.39.5

