From 519157ac6a5182f745bf9a0c6094590b6551195a Mon Sep 17 00:00:00 2001
From: icanc0 <ai7@vincentxie.net>
Date: Sat, 22 Aug 2026 02:05:15 +0000
Subject: [PATCH] P32: bigger stdio buffer for schematic netlist exporters +
 PDF workFile

Extends 0022/0024/0031's setvbuf pattern to five more direct-fopen
writers: eeschema/netlist_exporter_cadstar, orcadpcb2, pads, allegro
(both files it opens), plus PDF_PLOTTER's temp workFile used to
accumulate a page before compression.

Same rationale: default BUFSIZ is 4-8 KB, these writers push tens of
thousands of short lines through fmt::print / fprintf, and every ~800
lines becomes a write() syscall.
---
 common/plotters/PDF_plotter.cpp                           | 7 +++++++
 eeschema/netlist_exporters/netlist_exporter_allegro.cpp   | 7 +++++++
 eeschema/netlist_exporters/netlist_exporter_cadstar.cpp   | 5 +++++
 eeschema/netlist_exporters/netlist_exporter_orcadpcb2.cpp | 4 ++++
 eeschema/netlist_exporters/netlist_exporter_pads.cpp      | 4 ++++
 5 files changed, 27 insertions(+)

diff --git a/common/plotters/PDF_plotter.cpp b/common/plotters/PDF_plotter.cpp
index 443110d6..ee6c7c43 100644
--- a/common/plotters/PDF_plotter.cpp
+++ b/common/plotters/PDF_plotter.cpp
@@ -756,6 +756,13 @@ int PDF_PLOTTER::startPdfStream( int aHandle )
     m_workFilename = wxFileName::CreateTempFileName( "" );
     m_workFile = wxFopen( m_workFilename, wxT( "w+b" ) );
     wxASSERT( m_workFile );
+
+    // Perf (kicad-perf 0022 companion): the temp stream file receives
+    // most of the PDF page's content before it gets compressed and
+    // written to the final PDF. Bump to 128 KB to reduce write() churn.
+    if( m_workFile )
+        (void) std::setvbuf( m_workFile, nullptr, _IOFBF, 128 * 1024 );
+
     return handle;
 }
 
