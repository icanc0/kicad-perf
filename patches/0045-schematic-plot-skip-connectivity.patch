From: icanc0 <ai7@vincentxie.net>
Date: Sat, 22 Aug 2026 09:40:17 +0000
Subject: [PATCH] =?UTF-8?q?P45:=20eeschema=20JobExportPlot=20=E2=80=94=20s?=
 =?UTF-8?q?kip=20ConnectionGraph::Recalculate=20on=20load?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EESCHEMA_HELPERS::LoadSchematic already had an aCalculateConnectivity
bool parameter (default true). The CLI jobs handler wasn't threading
it through — every schematic export paid the connectivity + dangling-
ends recompute even for plot exports that only render items.

Add a two-arg getSchematic that plumbs the flag through. JobExportPlot
(covers svg/pdf/ps/dxf/hpgl/png) passes false. Netlist / BOM / ERC
still get the full-init path (they consult the ConnectionGraph).
---
 eeschema/eeschema_jobs_handler.cpp | 18 +++++++++++++++---
 eeschema/eeschema_jobs_handler.h   |  6 ++++++
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/eeschema/eeschema_jobs_handler.cpp b/eeschema/eeschema_jobs_handler.cpp
index 0f4931df..ca90e5bd 100644
--- a/eeschema/eeschema_jobs_handler.cpp
+++ b/eeschema/eeschema_jobs_handler.cpp
@@ -203,6 +203,12 @@ void EESCHEMA_JOBS_HANDLER::ClearCachedSchematic()
 
 
 SCHEMATIC* EESCHEMA_JOBS_HANDLER::getSchematic( const wxString& aPath )
+{
+    return getSchematic( aPath, /*aCalculateConnectivity=*/true );
+}
+
+
+SCHEMATIC* EESCHEMA_JOBS_HANDLER::getSchematic( const wxString& aPath, bool aCalculateConnectivity )
 {
     SCHEMATIC* sch = nullptr;
 
@@ -220,7 +226,8 @@ SCHEMATIC* EESCHEMA_JOBS_HANDLER::getSchematic( const wxString& aPath )
         }
 
         if( !m_cliSchematic )
-            m_cliSchematic = EESCHEMA_HELPERS::LoadSchematic( schPath, true, false, &project );
+            m_cliSchematic = EESCHEMA_HELPERS::LoadSchematic( schPath, true, false, &project,
+                                                              aCalculateConnectivity );
 
         sch = m_cliSchematic;
     }
@@ -233,7 +240,9 @@ SCHEMATIC* EESCHEMA_JOBS_HANDLER::getSchematic( const wxString& aPath )
     }
     else if( !aPath.IsEmpty() )
     {
-        sch = EESCHEMA_HELPERS::LoadSchematic( aPath, true, false );
+        sch = EESCHEMA_HELPERS::LoadSchematic( aPath, /*aSetActive=*/true,
+                                               /*aForceDefaultProject=*/false, /*aProject=*/nullptr,
+                                               aCalculateConnectivity );
     }
 
     if( !sch )
@@ -291,6 +300,9 @@ void EESCHEMA_JOBS_HANDLER::InitRenderSettings( SCH_RENDER_SETTINGS* aRenderSett
 }
 
 
+// Plot exports (svg/pdf/ps/dxf/hpgl/png) render items directly — they
+// don't consult the ConnectionGraph. Skipping connectivity recalculation
+// saves the largest fixed cost of the schematic load on big designs.
 int EESCHEMA_JOBS_HANDLER::JobExportPlot( JOB* aJob )
 {
     JOB_EXPORT_SCH_PLOT* aPlotJob = dynamic_cast<JOB_EXPORT_SCH_PLOT*>( aJob );
@@ -303,7 +315,7 @@ int EESCHEMA_JOBS_HANDLER::JobExportPlot( JOB* aJob )
         return CLI::EXIT_CODES::ERR_ARGS;
     }
 
-    SCHEMATIC* sch = getSchematic( aPlotJob->m_filename );
+    SCHEMATIC* sch = getSchematic( aPlotJob->m_filename, /*aCalculateConnectivity=*/false );
 
     if( !sch )
         return CLI::EXIT_CODES::ERR_INVALID_INPUT_FILE;
diff --git a/eeschema/eeschema_jobs_handler.h b/eeschema/eeschema_jobs_handler.h
index 0c38633d..577e317b 100644
--- a/eeschema/eeschema_jobs_handler.h
+++ b/eeschema/eeschema_jobs_handler.h
@@ -94,6 +94,12 @@ public:
 private:
     SCHEMATIC* getSchematic( const wxString& aPath );
 
+    /// Same as getSchematic() but the caller controls whether the
+    /// ConnectionGraph is recomputed. Plot exports (svg/pdf/ps/dxf/
+    /// hpgl/png) and upgrade paths don't need it; skipping saves a
+    /// noticeable chunk of the schematic-load wall time on big designs.
+    SCHEMATIC* getSchematic( const wxString& aPath, bool aCalculateConnectivity );
+
     int doSymExportSvg( JOB_SYM_EXPORT_SVG* aSvgJob, SCH_RENDER_SETTINGS* aRenderSettings,
                         LIB_SYMBOL* symbol );
 
-- 
