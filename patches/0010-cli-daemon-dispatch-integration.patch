+#ifndef CLI_DISPATCH_H
+#define CLI_DISPATCH_H
+
+namespace CLI
+{
+
+/**
+ * Run one kicad-cli invocation.
+ *
+ * Argv is (argc, argv) UTF-8 as delivered by wx / by a daemon request
+ * frame. Returns the CLI::EXIT_CODES value the underlying command handler
+ * returned (0 = success).
+ *
+ * Both `PGM_KICAD::OnPgmRun()` and the daemon dispatcher call this so
+ * every invocation, direct or remote, goes through the exact same
+ * argparse + subcommand-lookup + Perform path.
+ *
+ * Thread-safety: not re-entrant. Callers must serialize (the daemon does
+ * one client at a time by design; see analysis/02-daemon-mode-design.md
+ * safety concerns).
+ */
+int RunKicadCliDispatch( int argc, char** argv );
+
+} // namespace CLI
+
+#endif // CLI_DISPATCH_H
