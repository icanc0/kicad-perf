 #include <sys/stat.h>
 #include <sys/types.h>
@@ -323,11 +325,81 @@ static bool writeResponse( int aFd, int aExitCode, const std::string& aStdout,
 }
 
 
-// Per-client dispatch — reads one request frame, dispatches, writes response.
-// Actual command dispatch through commandStack lands in the *next* patch;
-// this one exercises framing end-to-end so the wire protocol can be
-// integration-tested from a Python client before we wire in the real
-// CLI runtime.
+// Capture stdout / stderr into pipes for one dispatch, restore afterwards.
+// Not thread-safe. Intended for a single-in-flight daemon (which is what
+// the MVP is).
+struct StdioCapture
+{
+    int saved_stdout = -1;
+    int saved_stderr = -1;
+    int pipe_stdout[2] = { -1, -1 };
+    int pipe_stderr[2] = { -1, -1 };
+
+    bool start()
+    {
+        saved_stdout = ::dup( STDOUT_FILENO );
+        saved_stderr = ::dup( STDERR_FILENO );
+
+        if( saved_stdout < 0 || saved_stderr < 0 )
+            return false;
+
+        if( ::pipe( pipe_stdout ) != 0 || ::pipe( pipe_stderr ) != 0 )
+            return false;
+
+        // Non-blocking on the read ends — we drain post-dispatch.
+        (void) ::fcntl( pipe_stdout[0], F_SETFL, O_NONBLOCK );
+        (void) ::fcntl( pipe_stderr[0], F_SETFL, O_NONBLOCK );
+
+        ::dup2( pipe_stdout[1], STDOUT_FILENO );
+        ::dup2( pipe_stderr[1], STDERR_FILENO );
+        ::close( pipe_stdout[1] );
+        ::close( pipe_stderr[1] );
+        return true;
+    }
+
+    // Restore original fds and return (stdout, stderr) capture.
+    std::pair<std::string, std::string> stop()
+    {
+        // Flush before restoring so any buffered text lands in the pipe.
+        std::fflush( stdout );
+        std::fflush( stderr );
+
+        ::dup2( saved_stdout, STDOUT_FILENO );
+        ::dup2( saved_stderr, STDERR_FILENO );
+        ::close( saved_stdout );
+        ::close( saved_stderr );
+        saved_stdout = saved_stderr = -1;
+
+        std::string outBuf, errBuf;
+        char        buf[4096];
+
+        for( ;; )
+        {
+            ssize_t n = ::read( pipe_stdout[0], buf, sizeof( buf ) );
+            if( n <= 0 )
+                break;
+            outBuf.append( buf, static_cast<size_t>( n ) );
+        }
+
+        for( ;; )
+        {
+            ssize_t n = ::read( pipe_stderr[0], buf, sizeof( buf ) );
+            if( n <= 0 )
+                break;
+            errBuf.append( buf, static_cast<size_t>( n ) );
+        }
+
+        ::close( pipe_stdout[0] );
+        ::close( pipe_stderr[0] );
+        pipe_stdout[0] = pipe_stderr[0] = -1;
+
+        return { std::move( outBuf ), std::move( errBuf ) };
+    }
+};
+
+
+// Per-client dispatch — reads request, redirects stdio, runs the CLI
+// command through the same code path OnPgmRun uses, sends response.
 static void handleOneClient( int aClientFd )
 {
     ParsedRequest req;
@@ -338,24 +410,64 @@ static void handleOneClient( int aClientFd )
         return;
     }
 
-    // Placeholder: echo argv to stdout capture. The follow-up patch swaps
-    // this for a real dispatch through PGM_KICAD::RunOneCliCommand().
-    std::string capturedStdout;
+    if( req.argv.empty() )
+    {
+        writeResponse( aClientFd, /*exit=*/CLI::EXIT_CODES::ERR_ARGS,
+                       /*stdout=*/{}, /*stderr=*/"empty argv\n" );
+        ::close( aClientFd );
+        return;
+    }
+
+    // Build a C-style argv the dispatcher expects. RunKicadCliDispatch takes
+    // char** but doesn't mutate — we back it with a std::vector<std::string>
+    // owned by req.argv.
+    std::vector<char*> argvC;
+    argvC.reserve( req.argv.size() );
+
+    for( std::string& s : req.argv )
+        argvC.push_back( s.data() );
+
+    // Change to the client's cwd so relative paths (input .kicad_pcb,
+    // -o output/) resolve where the caller expected.
+    char* prevCwd = ::getcwd( nullptr, 0 );
+
+    if( !req.cwd.empty() )
+        (void) ::chdir( req.cwd.c_str() );
+
+    StdioCapture cap;
+    bool         captureOk = cap.start();
 
-    for( size_t i = 0; i < req.argv.size(); ++i )
+    int exitCode = CLI::EXIT_CODES::ERR_UNKNOWN;
+
+    try
+    {
+        exitCode = CLI::RunKicadCliDispatch( static_cast<int>( argvC.size() ), argvC.data() );
+    }
+    catch( ... )
     {
-        capturedStdout += "argv[";
-        capturedStdout += std::to_string( i );
-        capturedStdout += "]=";
-        capturedStdout += req.argv[i];
-        capturedStdout += '\n';
+        exitCode = CLI::EXIT_CODES::ERR_UNKNOWN;
     }
 
-    capturedStdout += "cwd=";
-    capturedStdout += req.cwd;
-    capturedStdout += '\n';
+    std::string outBuf, errBuf;
+
+    if( captureOk )
+    {
+        auto p = cap.stop();
+        outBuf = std::move( p.first );
+        errBuf = std::move( p.second );
+    }
+    else
+    {
+        errBuf = "daemon: stdio capture failed\n";
+    }
+
+    if( prevCwd )
+    {
+        (void) ::chdir( prevCwd );
+        std::free( prevCwd );
+    }
 
-    writeResponse( aClientFd, /*exit=*/0, capturedStdout, /*stderr=*/std::string() );
+    writeResponse( aClientFd, exitCode, outBuf, errBuf );
     ::close( aClientFd );
 }
 
