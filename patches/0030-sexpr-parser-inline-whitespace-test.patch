From: icanc0 <ai7@vincentxie.net>
Date: Sat, 22 Aug 2026 00:42:04 +0000
Subject: [PATCH] =?UTF-8?q?P30:=20sexpr=5Fparser=20=E2=80=94=20inline=20wh?=
 =?UTF-8?q?itespace-char=20test=20instead=20of=20std::string::find?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

parseString's inner loop was doing 'whitespaceCharacters.find(*it) !=
npos' for every input byte — that's a linear scan over 7 characters
per byte. Replace with an inline switch that a good compiler turns
into either a jump table or a set of compares, hitting register-file
latency.

Same character set (' \t\n\r\b\f\v'). The whitespaceCharacters
string is still exported for the find_first_of() call in the
symbol-terminator scan (line 172), which needs a set.
---
 libs/sexpr/sexpr_parser.cpp | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/libs/sexpr/sexpr_parser.cpp b/libs/sexpr/sexpr_parser.cpp
index daf00fa4..702d11ba 100644
--- a/libs/sexpr/sexpr_parser.cpp
+++ b/libs/sexpr/sexpr_parser.cpp
@@ -33,6 +33,21 @@ namespace SEXPR
 {
     const std::string PARSER::whitespaceCharacters = " \t\n\r\b\f\v";
 
+    // Perf: hot per-char whitespace test. std::string::find scans linearly
+    // over 7 chars for every input byte; direct switch inlines to one
+    // compare + jump, and lets the compiler pick an efficient dispatch.
+    static inline bool isWhitespaceChar( char c )
+    {
+        switch( c )
+        {
+        case ' ':  case '\t': case '\n': case '\r':
+        case '\b': case '\f': case '\v':
+            return true;
+        default:
+            return false;
+        }
+    }
+
     PARSER::PARSER() : m_lineNumber( 1 )
     {
     }
@@ -99,7 +114,7 @@ namespace SEXPR
             if( *it == '\n' )
                 m_lineNumber++;
 
-            if( whitespaceCharacters.find(*it) != std::string::npos )
+            if( isWhitespaceChar( *it ) )
                 continue;
 
             if( *it == '(' )
@@ -114,7 +129,7 @@ namespace SEXPR
                     if( *it == '\n' )
                         m_lineNumber++;
 
-                    if( whitespaceCharacters.find( *it ) != std::string::npos )
+                    if( isWhitespaceChar( *it ) )
                     {
                         std::advance( it, 1 );
                         continue;
-- 
