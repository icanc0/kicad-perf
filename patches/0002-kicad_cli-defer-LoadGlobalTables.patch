Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 kicad/kicad_cli.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/kicad/kicad_cli.cpp b/kicad/kicad_cli.cpp
index a66a883f..518b3629 100644
--- a/kicad/kicad_cli.cpp
+++ b/kicad/kicad_cli.cpp
@@ -526,7 +526,8 @@ bool PGM_KICAD::OnPgmInit()
     GetSettingsManager().SetKiway( &Kiway );
     m_bm.Init();
 
-    GetLibraryManager().LoadGlobalTables();
+    // NOTE: LoadGlobalTables() was here; deferred to OnPgmRun() so --version,
+    // --help, and argparse-error paths skip it entirely.
 
     return true;
 }
@@ -635,6 +636,10 @@ int PGM_KICAD::OnPgmRun()
 
     if( cliCmd )
     {
+        // Load global sym/fp/design-block tables lazily. Skips --help,
+        // --version, and argparse-error paths.
+        GetLibraryManager().LoadGlobalTables();
+
         int exitCode = cliCmd->Perform( Kiway );
 
         if( exitCode != CLI::EXIT_CODES::AVOID_CLOSING )
