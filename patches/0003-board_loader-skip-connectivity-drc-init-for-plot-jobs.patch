 pcbnew/board_loader.h        | 15 ++++++++++++
 pcbnew/board_loader.cpp      | 39 ++++++++++++++++++++++--------
 pcbnew/pcbnew_jobs_handler.h |  4 +++
 pcbnew/pcbnew_jobs_handler.cpp | 45 ++++++++++++++++++++++++++++++++--
 4 files changed, 91 insertions(+), 12 deletions(-)

diff --git a/pcbnew/board_loader.h b/pcbnew/board_loader.h
--- a/pcbnew/board_loader.h
+++ b/pcbnew/board_loader.h
@@ -55,7 +55,22 @@ public:
         // if present, will be called with (sheet path, error message) on failure to load sheet
         std::function<void( const wxString&, const wxString& )> drawing_sheet_error_callback;

         bool initialize_after_load = true;
+
+        // Fine-grained toggles for `initialize_after_load`. All default true
+        // so existing callers see no behavior change. Plot / export jobs
+        // override the ones they do not need.
+        bool init_drc_engine        = true;   // instantiate DRC_ENGINE + InitEngine
+        bool build_connectivity     = true;   // full ratsnest graph
+        bool build_list_of_nets     = true;
+        bool sync_nets_and_classes  = true;
+        bool sync_component_classes = true;   // walk all fps, apply project rules
+        bool sync_tuning_profile    = true;
+        bool resolve_drc_exclusions = true;   // marker resolution
     };

diff --git a/pcbnew/board_loader.cpp b/pcbnew/board_loader.cpp
--- a/pcbnew/board_loader.cpp
+++ b/pcbnew/board_loader.cpp
@@ -138,29 +138,46 @@ void BOARD_LOADER::initializeLoadedBoard( BOARD* aBoard, const wxString& aFileNa
     aBoard->SetProject( aProject );

     BOARD_DESIGN_SETTINGS& bds = aBoard->GetDesignSettings();
-    bds.m_DRCEngine = std::make_shared<DRC_ENGINE>( aBoard, &bds );

-    try
+    if( aOptions.init_drc_engine )
     {
-        wxFileName rules = aFileName;
-        rules.SetExt( FILEEXT::DesignRulesFileExtension );
-        bds.m_DRCEngine->InitEngine( rules );
-    }
-    catch( ... )
-    {
-        // Only matters if user tries to run DRC later; will be reported at that time
+        bds.m_DRCEngine = std::make_shared<DRC_ENGINE>( aBoard, &bds );
+
+        try
+        {
+            wxFileName rules = aFileName;
+            rules.SetExt( FILEEXT::DesignRulesFileExtension );
+            bds.m_DRCEngine->InitEngine( rules );
+        }
+        catch( ... )
+        {
+            // Only matters if user tries to run DRC later; will be reported at that time
+        }
     }

-    for( PCB_MARKER* marker : aBoard->ResolveDRCExclusions( true ) )
-        aBoard->Add( marker );
+    if( aOptions.resolve_drc_exclusions )
+    {
+        for( PCB_MARKER* marker : aBoard->ResolveDRCExclusions( true ) )
+            aBoard->Add( marker );
+    }

-    aBoard->BuildConnectivity();
-    aBoard->BuildListOfNets();
-    aBoard->SynchronizeNetsAndNetClasses( true );
+    if( aOptions.build_connectivity )
+        aBoard->BuildConnectivity();
+
+    if( aOptions.build_list_of_nets )
+        aBoard->BuildListOfNets();
+
+    if( aOptions.sync_nets_and_classes )
+        aBoard->SynchronizeNetsAndNetClasses( true );

-    if( !aBoard->SynchronizeComponentClasses( std::unordered_set<wxString>() )
-        && aOptions.reporter )
+    if( aOptions.sync_component_classes
+        && !aBoard->SynchronizeComponentClasses( std::unordered_set<wxString>() )
+        && aOptions.reporter )
     {
         aOptions.reporter->Report( _( "Could not load component class assignment rules" ),
                                    RPT_SEVERITY_WARNING );
     }

-    aBoard->SynchronizeTuningProfileProperties();
+    if( aOptions.sync_tuning_profile )
+        aBoard->SynchronizeTuningProfileProperties();

     aBoard->UpdateUserUnits( aBoard, nullptr );
 }
diff --git a/pcbnew/pcbnew_jobs_handler.h b/pcbnew/pcbnew_jobs_handler.h
--- a/pcbnew/pcbnew_jobs_handler.h
+++ b/pcbnew/pcbnew_jobs_handler.h
@@ -113,7 +113,11 @@ private:
     TOOL_MANAGER*                 getToolManager( BOARD* aBrd );

     ///< The board loaded when running in CLI mode; cached per-invocation.
     BOARD* getBoard( const wxString& aPath = wxEmptyString );
+
+    ///< Load a board for a job whose semantics we know are read-only over
+    ///< geometry (plot / gerber / drill / dxf / ps / png / pdf). Skips
+    ///< connectivity / DRC / class sync work.
+    BOARD* getBoardForExport( const wxString& aPath, const JOB* aJob );
diff --git a/pcbnew/pcbnew_jobs_handler.cpp b/pcbnew/pcbnew_jobs_handler.cpp
--- a/pcbnew/pcbnew_jobs_handler.cpp
+++ b/pcbnew/pcbnew_jobs_handler.cpp
@@ -520,12 +520,15 @@ BOARD* PCBNEW_JOBS_HANDLER::getBoard( const wxString& aPath )
+// Fresh helper. Callers that know their job is a read-only geometry pass over
+// the board (SVG/PDF/PNG/DXF/PS/Gerber/Drill/GenCad/etc.) call this instead
+// of getBoard() so we don't pay for connectivity + DRC + class sync we
+// won't consult.
+BOARD* PCBNEW_JOBS_HANDLER::getBoardForExport( const wxString& aPath, const JOB* )
+{
+    BOARD_LOADER::OPTIONS opts;
+    opts.init_drc_engine        = false;
+    opts.build_connectivity     = false;
+    opts.build_list_of_nets     = false;
+    opts.sync_nets_and_classes  = false;
+    opts.sync_component_classes = false;
+    opts.sync_tuning_profile    = false;
+    opts.resolve_drc_exclusions = false;
+    return loadBoardWithOptions( aPath, opts );
+}
@@ -1406,7 +1409,7 @@ int PCBNEW_JOBS_HANDLER::JobExportSvg( JOB* aJob )
-    BOARD*        brd = getBoard( aSvgJob->m_filename );
+    BOARD*        brd = getBoardForExport( aSvgJob->m_filename, aJob );
     TOOL_MANAGER* toolManager = getToolManager( brd );
@@ -1498,7 +1501,7 @@ int PCBNEW_JOBS_HANDLER::JobExportDxf( JOB* aJob )
-    BOARD* brd = getBoard( aDxfJob->m_filename );
+    BOARD* brd = getBoardForExport( aDxfJob->m_filename, aJob );
@@ -1593,7 +1596,7 @@ int PCBNEW_JOBS_HANDLER::JobExportPdf( JOB* aJob )
-    BOARD* brd = getBoard( pdfJob->m_filename );
+    BOARD* brd = getBoardForExport( pdfJob->m_filename, aJob );
@@ -1688,7 +1691,7 @@ int PCBNEW_JOBS_HANDLER::JobExportPng( JOB* aJob )
-    BOARD* brd = getBoard( pngJob->m_filename );
+    BOARD* brd = getBoardForExport( pngJob->m_filename, aJob );
@@ -1762,7 +1765,7 @@ int PCBNEW_JOBS_HANDLER::JobExportPs( JOB* aJob )
-    BOARD* brd = getBoard( psJob->m_filename );
+    BOARD* brd = getBoardForExport( psJob->m_filename, aJob );
@@ -1858,7 +1861,7 @@ int PCBNEW_JOBS_HANDLER::JobExportGerbers( JOB* aJob )
-    BOARD* brd = getBoard( aGerberJob->m_filename );
+    BOARD* brd = getBoardForExport( aGerberJob->m_filename, aJob );

Note: `getBoard()` is refactored so that the actual load lives in a new
`loadBoardWithOptions()` helper that both `getBoard` and `getBoardForExport`
call. This diff shows the intent; the full refactor lives in the branch.
