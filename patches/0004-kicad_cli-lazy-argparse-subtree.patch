From: icanc0 <ai7@vincentxie.net>
Date: Fri, 21 Aug 2026 16:02:29 +0000
Subject: [PATCH] =?UTF-8?q?P4:=20kicad=5Fcli=20=E2=80=94=20lazy=20argparse?=
 =?UTF-8?q?=20subtree=20build=20(patch=200004)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Only construct the argparse subtree for the top-level command actually named
in argv. --help / -h at top level, no-command, and unknown-command still
build the full tree so we can render usage. Skips 8/9 of ~60 subcommand
parser constructions (and their per-arg gettext calls) for a typical
'kicad-cli pcb export svg …' invocation.
---
 kicad/kicad_cli.cpp | 54 +++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/kicad/kicad_cli.cpp b/kicad/kicad_cli.cpp
index 518b3629..cdb091d8 100644
--- a/kicad/kicad_cli.cpp
+++ b/kicad/kicad_cli.cpp
@@ -545,9 +545,59 @@ int PGM_KICAD::OnPgmRun()
 
     argParser.add_argument( ARG_HELP_SHORT, ARG_HELP ).help( UTF8STDSTR( ARG_HELP_DESC ) ).flag().nargs( 0 );
 
-    for( COMMAND_ENTRY& entry : commandStack )
+    // Perf: fast-path — only build the subtree for the top-level command
+    // named in argv. Constructing all 60+ subcommand parsers (each with
+    // 10-30 args, each calling gettext on their help strings) is wasted
+    // work when the user only invoked one of them.
+    //
+    // Falls back to the full tree when argv contains --help / -h at the
+    // top level (needs the full tree to render usage), or when argv[1]
+    // doesn't match any known top-level command (unknown-cmd path still
+    // needs the full tree to produce a good error message).
+    std::string wantedCommand;
+    bool        topLevelHelp = false;
+
+    for( int i = 1; i < m_argcUtf8; ++i )
+    {
+        std::string arg( m_argvUtf8[i] );
+
+        if( arg == ARG_HELP_SHORT || arg == ARG_HELP )
+        {
+            // A --help *after* a subcommand still wants that subcommand's
+            // subtree, not the full tree. Only treat --help before the
+            // first non-flag as top-level.
+            if( wantedCommand.empty() )
+                topLevelHelp = true;
+            break;
+        }
+
+        if( arg.empty() || arg[0] == '-' )
+            continue;
+
+        wantedCommand = arg;
+        break;
+    }
+
+    bool matched = false;
+
+    if( !topLevelHelp && !wantedCommand.empty() )
     {
-        recurseArgParserBuild( argParser, entry );
+        for( COMMAND_ENTRY& entry : commandStack )
+        {
+            if( entry.handler->GetName() == wantedCommand )
+            {
+                recurseArgParserBuild( argParser, entry );
+                matched = true;
+                break;
+            }
+        }
+    }
+
+    // Fall back to the full tree for --help, no-command, or unknown-command.
+    if( !matched )
+    {
+        for( COMMAND_ENTRY& entry : commandStack )
+            recurseArgParserBuild( argParser, entry );
     }
 
     try
