+BOARD* PCBNEW_JOBS_HANDLER::getBoardForExport( const wxString& aPath )
+{
+    // Fast path: caller knows their job is a read-only geometry pass over
+    // the board (SVG/PDF/PNG/DXF/PS/Gerber/Drill/GenCad/…). Skip the
+    // connectivity graph, DRC engine, component-class sync, and tuning
+    // profile sync — none of which the plotter or exporters consult.
+
+    SETTINGS_MANAGER& settingsManager = Pgm().GetSettingsManager();
+    wxString loadError;
+
+    BOARD_LOADER::OPTIONS opts;
+    opts.init_drc_engine        = false;
+    opts.build_connectivity     = false;
+    opts.build_list_of_nets     = false;
+    opts.sync_nets_and_classes  = false;
+    opts.sync_component_classes = false;
+    opts.sync_tuning_profile    = false;
+    opts.resolve_drc_exclusions = false;
+
+    // The interactive-GUI branch of getBoard() falls back to the editor's
+    // live BOARD*, which already has connectivity built — reuse it there.
+    if( Pgm().IsGUI() )
+        return getBoard( aPath );
+
+    wxString pcbPath = aPath;
+
+    if( pcbPath.IsEmpty() && Pgm().GetSettingsManager().IsProjectOpen() )
+    {
+        wxFileName path = Pgm().GetSettingsManager().Prj().GetProjectFullName();
+        path.SetExt( FILEEXT::KiCadPcbFileExtension );
+        path.MakeAbsolute();
+        pcbPath = path.GetFullPath();
+    }
+
+    if( !m_cliBoard )
+        m_cliBoard.reset( loadBoardWithOptions( settingsManager, pcbPath, opts, loadError ) );
+
+    BOARD* brd = m_cliBoard.get();
+
+    if( !brd )
+    {
+        wxString msg = _( "Failed to load board" );
+
+        if( !loadError.IsEmpty() )
+            msg += wxString::Format( wxS( ": %s" ), loadError );
+
+        m_reporter->Report( msg + '\n', RPT_SEVERITY_ERROR );
+    }
+
+    return brd;
+}
